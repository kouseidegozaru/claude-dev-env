// Forge Piano: Salamander Grand Piano (CC BY 3.0) の単音サンプルから組んだ自作ピアノ。
// 設計の正はこのファイル。scripts/sfz2sf2.py が描画用 SF2 へ決定的に変換する。
// 宣言音域 MIDI 54-81 (根音から +/-3 半音以内にゾーンを制限)。
// 層境界 vel 40/72/100。volume の層オフセットは検品の層別 RMS (先頭1秒, L/R パワー平均) から
// 「最も弱い層に素材レベルを揃える」形で算出した値。pan は校正の掃引で決めた +/-50%。
// <global> volume は校正で決めた全体ゲイン (dB)。
<global> volume=10.20

<region> sample=wav/A3v3_L.wav pitch_keycenter=57 lokey=54 hikey=58 lovel=0 hivel=40 volume=-0.00 pan=-50
